{
    "manifest_version": 3,
    "name": "AudiTex",
    "version": "0.2.3",
    "description": "Read any article aloud using on-device AI — no server required.",

    "permissions": [
        "activeTab",
        "tabs",
        "storage",
        "unlimitedStorage",
        "offscreen",
        "contextMenus",
        "downloads"
    ],

    "background": {
        "service_worker": "service-worker.js"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content-script.js"],
            "run_at": "document_idle"
        }
    ],

    "action": {
        "default_title": "AudiTex — Read this page aloud",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },

    "web_accessible_resources": [
        {
            "resources": [
                "wasm/*.wasm",
                "tts-worker.js",
                "offscreen.html"
            ],
            "matches": ["<all_urls>"]
        }
    ]
}